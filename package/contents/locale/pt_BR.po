msgid ""
"Auto: click toggles recording; hold 250 ms+ for push-to-talk. Hold: press-"
"and-hold only. Toggle: click to start/stop."
msgstr ""
"Automático: o clique alterna a gravação; segure 250 ms+ para falar. Segurar: "
"somente pressionar e segurar. Alternar: clique para iniciar/parar."

msgid "Voice shortcut:"
