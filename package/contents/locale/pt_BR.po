msgstr "Não foi possível enviar a mensagem transcrita."

msgid "Transcription canceled"
msgstr "Transcrição cancelada"

msgid "Recording too short or silent — try again."
msgstr "Gravação muito curta ou silenciosa — tente novamente."

msgid "Failed to read recorded audio."
msgstr "Falha ao ler o áudio gravado."

msgid "Failed to finalize recording"
msgstr "Falha ao finalizar a gravação"

msgid ""
"Failed to fetch gcloud token (exit %1): %2. Please ensure gcloud is "
"installed and authenticated."
msgstr ""
"Falha ao obter o token do gcloud (saída %1): %2. Certifique-se de que o "
"gcloud está instalado e autenticado."

msgid ""
"No skills found. Drop folders containing a SKILL.md into ~/.local/share/"
"plasmallm/skills/ (configure extra directories in Settings → Skills)."
msgstr ""
"Nenhuma habilidade encontrada. Adicione pastas contendo um SKILL.md em "
"~/.local/share/plasmallm/skills/ (configure diretórios extras em "
"Configurações → Habilidades)."

